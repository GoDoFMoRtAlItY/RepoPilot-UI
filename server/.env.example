PORT=3001
GITHUB_TOKEN=your_github_personal_access_token_here
CORS_ORIGIN=http://localhost:5173

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Provider
AI_PROVIDER=openrouter

# Default OpenRouter model
OPENROUTER_MODEL=qwen/qwen3-30b-a3b:free

# --- Time Machine (Gemma 4) ---
# Gemma is reached through the first configured backend: Gemini API key, OpenRouter key, or a local Ollama server.
# Force one with GEMMA_BACKEND=gemini|openrouter|ollama (default: auto).
# GEMMA_BACKEND=auto
# GEMMA_MODEL=gemma-4-31b-it            # Gemini API id; use google/gemma-4-31b-it with OpenRouter
# OLLAMA_URL=http://localhost:11434      # local, private inference
# GEMMA_OLLAMA_MODEL=gemma4:e4b
# GEMMA_TIMEOUT_MS=90000
